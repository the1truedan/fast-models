# Copy to .env on Unraid and edit before first start:
#   cp .env.example .env
#
# Discover stable device paths AFTER bifurcation + both drives visible:
#   ls -l /dev/disk/by-id/nvme-*
#
# Use whole-disk by-id nodes (…nvme-… without -partN), not /dev/nvmeXnY alone
# if you can avoid it — by-id survives reboot device renumbering.

# --- required: dual NVMe block devices ---
NVME0=/dev/disk/by-id/nvme-REPLACE_DRIVE_0
NVME1=/dev/disk/by-id/nvme-REPLACE_DRIVE_1

# --- format safety (destructive) ---
# First boot only when drives are empty: ALLOW_FORMAT=1
# Then set ALLOW_FORMAT=0 and restart. Never leave FORCE_FORMAT=1 on disk.
ALLOW_FORMAT=0
FORCE_FORMAT=0

# --- NFS ---
# Tighten to your LAN / Tailscale CIDRs in production
NFS_CLIENTS=192.168.0.0/16
NFSD_THREADS=8
ENABLE_NFS=1

# --- bees dedupe (background space saver; duperemove is optional manual) ---
ENABLE_BEES=1
# Keep 1 on ~32 GiB Unraid hosts unless RAM/CPU is clearly free
BEES_THREADS=1
# v0.11 extent scan (4) — good for near-identical model files
BEES_SCAN_MODE=4
# Fingerprint table under APPDATA/bees (multiple of 128K). RSS ≈ this size.
# 1G is only a starter. On multi-TiB pools (our production ~1.6 TiB used) use 2G.
# Step to 4G only if occupancy stays ~full after a full re-crawl — host has no swap.
# Changing this alone does NOT resize an existing beeshash.dat; replace the file
# while bees is stopped (fresh empty table + crawl reset). See README / HOWTO.
BEES_HASH_SIZE=2G

# --- pool ---
BTRFS_LABEL=fast-models

# --- host paths ---
APPDATA=/mnt/user/appdata/fast-models
TZ=America/Chicago

